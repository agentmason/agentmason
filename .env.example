# AgentMason environment settings

DATABASE_URL=postgresql+psycopg://agentmason:agentmason@localhost:5432/agentmason
REDIS_URL=redis://localhost:6379/0
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# OpenAI
OPENAI_API_KEY=sk-...

# RAG Configuration
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RAG_TOP_K=5
MAX_UPLOAD_SIZE_MB=25
VECTOR_STORE=pgvector
LOCAL_STORAGE_PATH=./storage

